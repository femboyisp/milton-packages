[Desktop Entry]
Type=Application
Name=Mullvad Browser
GenericName=Web Browser
Comment=Privacy-focused web browser designed to minimize tracking and fingerprinting
Exec=/usr/bin/mullvad-browser %u
Icon=mullvad-browser
Categories=Network;WebBrowser;Security;
MimeType=text/html;text/xml;application/xhtml+xml;application/xml;application/rss+xml;application/rdf+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=Mullvad Browser
